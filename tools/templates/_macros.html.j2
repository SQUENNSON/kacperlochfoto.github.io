{# Logo SQphoto: <use> symbolu #sq-logo wstawionego raz w base.html.j2 (kolor = currentColor). #}
{% macro logo_svg(width) -%}
<svg class="logo-svg" viewBox="{{ logo.use_viewbox }}" width="{{ width }}" height="{{ (width / logo.ratio)|round(1) }}" fill="currentColor" aria-hidden="true" focusable="false"><use href="#sq-logo"/></svg>
{%- endmacro %}

{# Zdjecie = link do najwiekszego pliku (bez JS otwiera pelny plik). Lightbox (Task 5) czyta a.ph[data-lb]
   i data-*; kolejnosc [data-lb] w DOM = kolejnosc w lightboxie. Kolor --c widac, zanim obraz sie zaladuje. #}
{% macro photo_link(photo, p, sizes, hero=False, focus="", eager=False) -%}
<a class="ph{{ ' hero' if hero }}" href="{{ p }}{{ photo.variants[-1].file }}" data-lb data-srcset="{{ srcset(photo, p) }}" data-w="{{ photo.w }}" data-h="{{ photo.h }}" style="--c:{{ photo.color }}{% if not hero %};--r:{{ (photo.w / photo.h)|round(4) }}{% endif %}"><img src="{{ p }}{{ photo.variants[0].file }}" srcset="{{ srcset(photo, p) }}" sizes="{{ sizes }}" width="{{ photo.w }}" height="{{ photo.h }}" alt="{{ photo_alt[photo.category] }}"
{%- if hero %} loading="eager" fetchpriority="high" style="object-position:{{ focus }}"
{%- elif eager %} decoding="async"
{%- else %} loading="lazy" decoding="async"
{%- endif %}></a>
{%- endmacro %}

{# Hero: szeroki kadr u gory strony (jedyne miejsce, gdzie zdjecie jest przyciete: object-fit cover). #}
{% macro hero(photo, p, focus) -%}
{{ photo_link(photo, p, HERO_SIZES, hero=True, focus=focus) }}
{%- endmacro %}

{% macro hero_preload(photo, p) -%}
<link rel="preload" as="image" type="image/avif" imagesrcset="{{ srcset(photo, p) }}" imagesizes="{{ HERO_SIZES }}" fetchpriority="high">
{%- endmacro %}

{# Wiersz bez przycinania: elementy rosna proporcjonalnie do w/h (--r), wiec maja rowna wysokosc.
   eager = wiersz na pierwszym ekranie (bez loading="lazy"). #}
{% macro row(photos, p, sizes, eager=False) -%}
<div class="row" data-reveal>
{% for photo in photos %}
  {{ photo_link(photo, p, sizes, eager=eager) }}
{% endfor %}
</div>
{%- endmacro %}

{% macro ig_icon() -%}
<svg class="ig-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.6" cy="6.4" r=".9" fill="currentColor"/></svg>
{%- endmacro %}
