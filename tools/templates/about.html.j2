{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block main %}
<article class="page about">
  <h1 class="eyebrow" data-reveal>{{ page.heading }}</h1>
  <p class="lead" data-reveal>{{ page.lead|nbsp }}</p>
{% for paragraph in page.paragraphs %}
  <p data-reveal>{{ paragraph|nbsp }}</p>
{% endfor %}
</article>
{% if works %}
<section class="page works" aria-labelledby="works-title">
  <h2 class="works-title" id="works-title" data-reveal>{{ page.works_heading|nbsp }}</h2>
  <ul class="works-list">
{% for photo in works %}
    <li class="work" data-reveal>{{ m.work(photo, p) }}</li>
{% endfor %}
  </ul>
</section>
{% endif %}
{% endblock %}
