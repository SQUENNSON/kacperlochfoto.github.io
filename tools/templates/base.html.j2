{% import "_macros.html.j2" as m %}
<!doctype html>
<html lang="pl">
<head>
{% block head_first %}{% endblock %}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.title }}</title>
<meta name="description" content="{{ page.description }}">
{% if page.key == "404" %}
<meta name="robots" content="noindex">
{% else %}
<link rel="canonical" href="{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="SQphoto">
<meta property="og:locale" content="pl_PL">
<meta property="og:title" content="{{ page.title }}">
<meta property="og:description" content="{{ page.description }}">
<meta property="og:url" content="{{ page.url }}">
{% endif %}
<meta name="theme-color" content="#f4f2ee">
<link rel="preload" href="{{ p }}assets/fonts/schibsted-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ p }}assets/fonts/instrument-serif-italic-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ p }}assets/css/style.css">
<link rel="icon" href="{{ p }}assets/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ p }}assets/img/apple-touch-icon.png">
<script type="module" src="{{ p }}assets/js/main.js"></script>
<noscript><style>@media (max-width:900px){.menu-btn{display:none}.side{position:static;visibility:visible;opacity:1;padding-top:40px}.side>*{transform:none}}</style></noscript>
{% block head_extra %}{% endblock %}
</head>
<body>
<svg class="sprite" aria-hidden="true"><symbol id="sq-logo" viewBox="{{ logo.viewbox }}">{{ logo.body }}</symbol></svg>
<header class="topbar">
  <a class="logo" href="{{ p or './' }}" aria-label="SQphoto — strona główna">{{ m.logo_svg(110) }}</a>
  <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav" aria-label="Menu"><span></span><span></span></button>
</header>
<aside class="side">
  <div class="brand">
    <a class="logo" href="{{ p or './' }}" aria-label="SQphoto — strona główna">{{ m.logo_svg(150) }}</a>
    <p class="name">{{ site.name }}</p>
    <p class="tag">{{ site.tagline }}</p>
  </div>
  <nav class="nav" id="nav" aria-label="Menu główne">
{% for item in nav_items %}
    <a href="{{ item.href }}"{% if item.key == page.nav %} aria-current="page"{% endif %}><span class="num" aria-hidden="true">{{ item.num }}</span><span class="roll"><b>{{ item.label }}</b><em aria-hidden="true">{{ item.label }}</em></span></a>
{% endfor %}
  </nav>
  <div class="foot">
    <a class="m-only" href="{{ site.phone_href }}">{{ site.phone }}</a>
    <a class="m-only" href="mailto:{{ site.email }}">{{ site.email }}</a>
    <a class="ig" href="{{ site.instagram }}" target="_blank" rel="noopener">{{ m.ig_icon() }}{{ site.instagram_handle }}</a>
    <span class="loc">{{ site.location }}</span>
  </div>
</aside>
<main id="main">
{% block main %}{% endblock %}
</main>
</body>
</html>
