{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block head_extra %}
{{ m.hero_preload(hero, p) }}
{% endblock %}
{% block main %}
<h1 class="vh">{{ page.heading }}</h1>
{{ m.hero(hero, p, page.hero_focus) }}
<div class="rows">
{% for photos in rows %}
{{ m.row(photos, p, GRID_SIZES, eager=loop.first) }}
{% endfor %}
</div>
{% endblock %}
